rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/records/{record} {
      allow read: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['key', 'json', 'deleted'])
        && request.resource.data.key is string
        && request.resource.data.key.size() < 8000
        && request.resource.data.json is string
        && request.resource.data.json.size() < 900000
        && request.resource.data.deleted is bool;
      // Deletions are tombstones, so an offline device sees the deletion.
      allow delete: if false;
    }
    match /users/{uid}/sync/state {
      allow read: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['schema', 'changedAt'])
        && request.resource.data.schema == 1
        && request.resource.data.changedAt == request.time;
    }
  }
}
